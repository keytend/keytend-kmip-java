<!-- The versions-maven-plugin reports (pom.xml) ignore pre-releases (alphas, betas, release
     candidates, milestones and snapshots) and this project's own artifacts. -->
<ruleset xmlns="https://www.mojohaus.org/VERSIONS/RULE/2.1.0" comparisonMethod="maven">
  <ignoreVersions>
    <ignoreVersion type="regex">(?i).*[.-](alpha|beta|b|rc|cr|m|ea|pr|preview|snapshot)[.-]?\d*([.-].*)?</ignoreVersion>
  </ignoreVersions>
  <rules>
    <!-- This project's own artifacts: a local repository may hold other builds of them. -->
    <rule groupId="dev.keytend">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
  </rules>
</ruleset>
