<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.keytend</groupId>
    <artifactId>keytend-kmip-parent</artifactId>
    <version>0.10.0-rc.1</version>
  </parent>
  <artifactId>keytend-kmip-micrometer</artifactId>
  <name>keytend-kmip Micrometer metrics</name>
  <description>Experimental, not for production use. Opt-in Micrometer meters for keytend-kmip: calls, attempts, endpoints, connections, LocalKeys, leases and TLS identities</description>
  <properties>
    <!-- An SBOM of the module and its runtime graph (Micrometer), shipped and published beside it. -->
    <cyclonedx.skip>false</cyclonedx.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>dev.keytend</groupId>
      <artifactId>keytend-kmip</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The application's own registry type: a normal dependency, never shaded or bundled. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The in-memory KMIP server, for tests only (never at run time). -->
    <dependency>
      <groupId>dev.keytend</groupId>
      <artifactId>keytend-kmip-testing</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The SDK's classes before package (./mvnw test, an IDE) require Caffeine, which the SDK JAR
         bundles from package on (sdk/pom.xml, "The bundled Caffeine"): test scope only. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!--
        HdrHistogram, which micrometer-core needs at runtime, is offered under CC0 or BSD-2-Clause
        (its POM names both). This module takes it under BSD-2-Clause, which the shipped-license
        check allows; the override names that one artifact and version only, and CC0 stays outside
        every allowed list. Review it when the HdrHistogram version changes.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shipped-licenses</id>
            <configuration>
              <overrideUrl>file://${project.basedir}/licenses.properties</overrideUrl>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Doclint over the module's package, failing on any error or warning, as in the SDK. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>doclint</id>
            <goals>
              <goal>javadoc-no-fork</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <doclint>all</doclint>
              <failOnWarnings>true</failOnWarnings>
              <quiet>true</quiet>
              <outputDirectory>${project.build.directory}/doclint</outputDirectory>
              <staleDataPath>${project.build.directory}/doclint-stale-data.txt</staleDataPath>
              <!-- A check only, whose HTML is not shipped: no links to the SDK's pages, which
                   maven-javadoc-plugin 3.12.0 looks for under sdk/target/target. -->
              <detectOfflineLinks>false</detectOfflineLinks>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- SpotBugs with find-sec-bugs over the module's code, at the lowest threshold. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotbugs</id>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The tests also compile the guide's metrics examples, with javax.tools (java.compiler),
           which this module does not need. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>--add-modules=java.compiler</arg>
                <arg>--add-reads=dev.keytend.kmip.micrometer=java.compiler</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{jacocoArgLine} --add-modules java.compiler --add-reads dev.keytend.kmip.micrometer=java.compiler</argLine>
          <systemPropertyVariables>
            <!-- No SLF4J provider in these tests: the SDK's logs go nowhere, without SLF4J's notice. -->
            <slf4j.internal.verbosity>ERROR</slf4j.internal.verbosity>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
