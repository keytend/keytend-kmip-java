<!--
  What SpotBugs (with find-sec-bugs) reports on the SDK's main code and is not a defect. Each entry
  says why. Narrow entries name the class (and field or method); a pattern excluded everywhere is
  one the SDK uses by design.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!-- Methods record or wrap a failure and rethrow it; the SDK's failures are unchecked by design. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>

  <!-- The exceptions are Serializable only because Throwable is; the SDK does not support
       serializing them (javac's serial lint is off for the same reason). -->
  <Match>
    <Bug pattern="SE_BAD_FIELD,SE_NO_SERIALVERSIONID"/>
  </Match>

  <!-- Handles and results hand out the objects they hold (keys, certificates, the session, the
       Kms's key operations), as their Javadoc says; byte arrays are copied where the API says so,
       and Rewrapped.bytes() returns the caller's own array when nothing changed, as documented. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- Every argument the SDK logs goes through kms.LogText.safe, which escapes CR, LF and every other
       control character, so a value cannot forge a log line; find-sec-bugs does not see that
       sanitizer. The log formats themselves are constants. -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>

  <!-- Test hooks: package-private fields that only tests set, to run code at a chosen moment. -->
  <Match>
    <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    <Field name="~(before|after)[A-Z].*"/>
  </Match>

  <!-- Written under a lock SpotBugs does not see: the ReentrantLock "lock" (CurrentKey.failures),
       the exchange permit (HashedPasswordTransport.wiped), the "checking" flag taken by
       compareAndSet (TlsFiles), the monitor of "progress" (LocalKeys.progressVersion) and of the
       slot (LocalKeys.Slot.displaced). -->
  <Match>
    <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    <Or>
      <And><Class name="dev.keytend.kmip.kms.CurrentKey"/><Field name="failures"/></And>
      <And><Class name="dev.keytend.kmip.transport.HashedPasswordTransport"/><Field name="wiped"/></And>
    </Or>
  </Match>
  <Match>
    <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE"/>
    <Class name="~dev\.keytend\.kmip\.kms\.TlsFiles(\$.*)?"/>
    <Field name="changedSince"/>
  </Match>
  <Match>
    <Bug pattern="VO_VOLATILE_INCREMENT"/>
    <Class name="~dev\.keytend\.kmip\.kms\.LocalKeys(\$.*)?"/>
    <Field name="~progressVersion|displaced"/>
  </Match>

  <!-- A key file without encryption parameters: the NullPointerException is caught with the other
       failures to read the iteration count and reported as such. -->
  <Match>
    <Bug pattern="NP_NULL_ON_SOME_PATH"/>
    <Class name="dev.keytend.kmip.kms.PemIdentity"/>
    <Method name="decrypt"/>
  </Match>

  <!-- directoryOf() refuses a target without a file name first, so getFileName() and the parent of
       its absolute path are not null. -->
  <Match>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    <Class name="dev.keytend.kmip.kms.StagedFiles"/>
  </Match>

  <!-- A renewed private key is written in the encrypted PKCS#8 form OpenSSL and the JDK read:
       PBES2, AES-256-CBC under a PBKDF2-HMAC-SHA256 key (RFC 8018). PKCS#8 has no authenticated
       mode that both read. Nothing answers decryption attempts, so there is no padding oracle: the
       file is the owner's, written owner-only, and only the SDK reads it with the key file's
       password. -->
  <Match>
    <Bug pattern="CIPHER_INTEGRITY,PADDING_ORACLE"/>
    <Class name="dev.keytend.kmip.kms.RenewalFiles"/>
    <Method name="encrypt"/>
  </Match>
  <!-- One random challenge per check that a key matches its certificate. -->
  <Match>
    <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    <Class name="dev.keytend.kmip.kms.PemIdentity"/>
  </Match>

  <!-- The alert pattern is a fixed alternation of names between lookarounds; no nested repetition. -->
  <Match>
    <Bug pattern="REDOS"/>
    <Class name="dev.keytend.kmip.kms.Failures"/>
  </Match>

  <!-- "shared" is the endpoint state the Kms instances of one configuration share, never exposed. -->
  <Match>
    <Bug pattern="USO_UNSAFE_ACCESSIBLE_OBJECT_SYNCHRONIZATION"/>
    <Class name="dev.keytend.kmip.kms.Kms"/>
  </Match>

  <!-- execute()'s attempts() catches what the call's body throws, checked or not, to classify it. -->
  <Match>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
    <Class name="dev.keytend.kmip.kms.Kms"/>
    <Method name="attempts"/>
  </Match>

  <!-- DateTimeExtended is written as a plain long, as the Long Integer and Interval types are. -->
  <Match>
    <Bug pattern="DB_DUPLICATE_SWITCH_CLAUSES"/>
    <Class name="dev.keytend.kmip.codec.TextValues"/>
  </Match>

  <!-- Casts whose type the call guarantees (the socket an SSLSocketFactory or SSLServerSocket makes,
       the key a factory makes for the spec it was given). -->
  <Match>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
  </Match>

  <!-- equalsIgnoreCase over ASCII names (URI schemes, JCA algorithm names, media types). -->
  <Match>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>

  <!-- Null means "absent", which an empty array would not distinguish. -->
  <Match>
    <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS"/>
  </Match>

  <!-- Anonymous classes made once per configuration or follower; their size does not matter. -->
  <Match>
    <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON"/>
  </Match>

  <!-- Keys decodes key material it is given; it holds no key. -->
  <Match>
    <Bug pattern="HARD_CODE_KEY"/>
    <Class name="dev.keytend.kmip.model.Keys"/>
  </Match>

  <!-- Retry jitter, not a secret. -->
  <Match>
    <Bug pattern="PREDICTABLE_RANDOM"/>
    <Class name="dev.keytend.kmip.kms.RetryPolicy"/>
  </Match>

  <!-- The TCP socket the TLS socket is layered on. -->
  <Match>
    <Bug pattern="UNENCRYPTED_SOCKET"/>
    <Class name="dev.keytend.kmip.transport.TlsTransport"/>
  </Match>

  <!-- The staged file is created next to the target the application names. -->
  <Match>
    <Bug pattern="PATH_TRAVERSAL_IN"/>
    <Class name="~dev\.keytend\.kmip\.kms\.StagedFiles(\$.*)?"/>
  </Match>
</FindBugsFilter>
