From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Author: Jeremiah Jordan
Date: Sun, 1 Nov 2026 18:39:37 -0600
Subject: [PATCH 1/4] Commit log disk access mode: count transparent data
 encryption before the encryption context is applied

resolveCommitLogWriteDiskAccessMode and validateCommitLogWriteDiskAccessMode run before
applyEncryptionContext, so with transparent_data_encryption_options enabled they saw no
encryption and chose (or accepted) a direct-I/O mode the encrypted segment cannot use.
They now fall back to the configuration until the context is applied.
---
 .../cassandra/config/DatabaseDescriptor.java    | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/src/java/org/apache/cassandra/config/DatabaseDescriptor.java b/src/java/org/apache/cassandra/config/DatabaseDescriptor.java
index 78606e4..b18160b 100644
--- a/src/java/org/apache/cassandra/config/DatabaseDescriptor.java
+++ b/src/java/org/apache/cassandra/config/DatabaseDescriptor.java
@@ -1608,6 +1608,17 @@ public class DatabaseDescriptor
         }
     }
 
+    /**
+     * Whether files are encrypted. The commit log disk access mode is chosen before the encryption context is applied,
+     * so fall back to the configuration until it is.
+     */
+    private static boolean isTransparentDataEncryptionEnabled()
+    {
+        if (encryptionContext != null)
+            return encryptionContext.isEnabled();
+        return conf != null && conf.transparent_data_encryption_options != null && conf.transparent_data_encryption_options.enabled;
+    }
+
     public static void applyEncryptionContext()
     {
         // always attempt to load the cipher factory, as we could be in the situation where the user has disabled encryption,
@@ -1871,7 +1882,7 @@ public class DatabaseDescriptor
 
     private static Pair<DiskAccessMode, Boolean> resolveCommitLogWriteDiskAccessMode(DiskAccessMode providedDiskAccessMode)
     {
-        boolean compressOrEncrypt = getCommitLogCompression() != null || (getEncryptionContext() != null && getEncryptionContext().isEnabled());
+        boolean compressOrEncrypt = getCommitLogCompression() != null || isTransparentDataEncryptionEnabled();
         boolean directIOSupported = false;
         // File.getBlockSize creates directories/files tools may not have permissions for
         if (!toolInitialized)
@@ -1918,7 +1929,7 @@ public class DatabaseDescriptor
 
     private static void validateCommitLogWriteDiskAccessMode(Pair<DiskAccessMode, Boolean> accessModeDirectIoPair) throws ConfigurationException
     {
-        boolean compressOrEncrypt = getCommitLogCompression() != null || (getEncryptionContext() != null && getEncryptionContext().isEnabled());
+        boolean compressOrEncrypt = getCommitLogCompression() != null || isTransparentDataEncryptionEnabled();
 
         if (!accessModeDirectIoPair.right && accessModeDirectIoPair.left == DiskAccessMode.direct)
         {
@@ -1927,7 +1938,7 @@ public class DatabaseDescriptor
         else if (compressOrEncrypt && accessModeDirectIoPair.left != DiskAccessMode.standard)
         {
             String with;
-            if (null != getCommitLogCompression() && (null != getEncryptionContext() && getEncryptionContext().isEnabled()))
+            if (null != getCommitLogCompression() && isTransparentDataEncryptionEnabled())
                 with = "compression or encryption";
             else if (null != getCommitLogCompression())
                 with = "compression";
