+package org.apache.cassandra.security;
+
+/**
+ * The key of an encrypted file cannot be had now (the key provider failed, a KMS is unreachable, the key's
+ * authorization ended). The file is intact: this is never a reason to treat it as corrupt, or to write unencrypted.
+ */
+public class EncryptionKeyUnavailableException extends RuntimeException
+{
+    public EncryptionKeyUnavailableException(String message, Throwable cause)
+    {
+        super(message, cause);
+    }
+}
