 .../hints/HintsDispatchExecutor.java          |  8 +++
 .../apache/cassandra/hints/HintsReader.java   |  5 ++
 .../apache/cassandra/hints/HintsService.java  |  8 +++
 .../cassandra/hints/HintsWriteExecutor.java   | 23 ++++++-
 .../EncryptionKeyUnavailableException.java    | 31 ++++++++++
 6 files changed, 127 insertions(+), 10 deletions(-)
 create mode 100644 src/java/org/apache/cassandra/security/EncryptionKeyUnavailableException.java

