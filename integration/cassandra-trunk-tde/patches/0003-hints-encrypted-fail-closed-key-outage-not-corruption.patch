@@ -163,14 +169,16 @@ final class HintsDescriptor
 
             try
             {
-                Cipher cipher;
                 if (encryptionConfig.containsKey(EncryptionContext.ENCRYPTION_IV))
                 {
-                    cipher = encryptionContext.getDecryptor();
