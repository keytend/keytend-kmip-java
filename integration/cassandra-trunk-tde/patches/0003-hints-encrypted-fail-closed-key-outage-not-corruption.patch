@@ -331,7 +341,7 @@ final class HintsDescriptor
 
     public boolean isEncrypted()
     {
-        return cipher != null;
+        return encryptionContext != null;
     }
 
     public ICompressor createCompressor()
@@ -343,9 +353,43 @@ final class HintsDescriptor
         return null;
     }
 
+    /**
+     * The cipher of a file being written, or a new decryptor for a file being read, made now with its key.
+     *
+     * @throws EncryptionKeyUnavailableException when the key cannot be had now; the file is intact
+     */
     public Cipher getCipher()
     {
-        return isEncrypted() ? cipher : null;
+        if (cipher != null || encryptionContext == null)
+            return cipher;
+        try
+        {
+            return encryptionContext.getDecryptor();
+        }
+        catch (IOException e)
+        {
+            throw new EncryptionKeyUnavailableException("cannot decrypt hints file " + hintsFileName + ": " + e.getMessage(), e);
+        }
+    }
+
+    /**
+     * Before a file being written is appended to: initializes its cipher again with its key, when the key provider's
+     * authorization of the key is limited in time.
+     *
+     * @throws EncryptionKeyUnavailableException when the key may no longer encrypt, or cannot be had now
+     */
+    void reauthorizeCipher()
+    {
+        if (cipher == null)
+            return;
+        try
+        {
+            encryptionContext.reauthorize(cipher);
+        }
+        catch (IOException e)
+        {
+            throw new EncryptionKeyUnavailableException("cannot append to hints file " + hintsFileName + ": " + e.getMessage(), e);
+        }
     }
 
     @Override
