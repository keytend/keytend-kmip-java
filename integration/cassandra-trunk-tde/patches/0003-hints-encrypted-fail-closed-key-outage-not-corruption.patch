         {
             // If we exceed the size limit for a hints file then close the current writer,
             // if we still have more to write, we'll open a new file in the next iteration.
-            if (!flushInternal(iterator, store.getOrOpenWriter()))
+            if (!flushInternal(iterator, authorizedWriter(store)))
                 store.closeWriter();
         }
     }
 
+    /**
+     * The store's writer, once its file's key has been checked again. A file whose key may no longer encrypt is closed
+     * (it stays readable while its key may still decrypt), and the hints go to a new file under the current key.
+     */
+    private static HintsWriter authorizedWriter(HintsStore store)
+    {
+        HintsWriter writer = store.getOrOpenWriter();
+        try
+        {
+            writer.descriptor().reauthorizeCipher();
+            return writer;
+        }
+        catch (EncryptionKeyUnavailableException e)
+        {
+            logger.warn("Closing hints file {}, which can no longer be appended to: {}", writer.descriptor().fileName(), e.getMessage());
+            store.closeWriter();
+            return store.getOrOpenWriter();
+        }
+    }
+
     /**
      * @return {@code true} if we can keep writing to the file,
      *      or {@code false} if we've exceeded max file size limit during writing
