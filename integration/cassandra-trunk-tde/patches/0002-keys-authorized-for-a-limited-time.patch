+    private EncryptionContext(TransparentDataEncryptionOptions tdeOptions, byte[] iv, CipherFactory cipherFactory)
+    {
+        this.tdeOptions = tdeOptions;
+        compressor = LZ4Compressor.create(Collections.<String, String>emptyMap());
+        chunkLength = tdeOptions.chunk_length_kb * 1024;
+        this.iv = iv;
+        this.cipherFactory = cipherFactory;
+    }
+
+    /**
+     * The context and the cipher for writing one new file: the configured key alias resolved once by the key provider
+     * ({@link KeyProvider#keyForNewFile}), so that the file's cipher and the alias in its header name the same key.
+     */
+    public NewFile forNewFile() throws IOException
+    {
+        if (!isEnabled() || cipherFactory == null)
+            throw new IllegalStateException("transparent data encryption is not enabled");
+        CipherFactory.FileCipher file = cipherFactory.getEncryptorForNewFile(tdeOptions.cipher, tdeOptions.key_alias);
+        EncryptionContext context = file.alias.equals(tdeOptions.key_alias)
+                                    ? this
+                                    : new EncryptionContext(withAlias(tdeOptions, file.alias), iv, cipherFactory);
+        return new NewFile(context, file.cipher);
+    }
