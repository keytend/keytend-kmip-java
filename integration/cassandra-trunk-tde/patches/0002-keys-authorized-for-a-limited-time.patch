+    /** The encryption of one new file: its context, whose header parameters name its key, and its cipher. */
+    public static final class NewFile
+    {
+        public final EncryptionContext context;
+        public final Cipher cipher;
+
+        private NewFile(EncryptionContext context, Cipher cipher)
+        {
+            this.context = context;
+            this.cipher = cipher;
+        }
+    }
+
+    private static TransparentDataEncryptionOptions withAlias(TransparentDataEncryptionOptions options, String alias)
+    {
+        TransparentDataEncryptionOptions copy = new TransparentDataEncryptionOptions(options.enabled, options.cipher, alias, options.key_provider);
+        copy.chunk_length_kb = options.chunk_length_kb;
+        copy.iv_length = options.iv_length;
+        return copy;
+    }
