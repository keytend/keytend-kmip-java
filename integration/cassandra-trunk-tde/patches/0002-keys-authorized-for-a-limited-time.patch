+    /**
+     * Initializes the encryptor of a file still being appended to again, with its key asked for again
+     * ({@link KeyProvider#keyForAppend}) and the IV its header records, when the provider's keys may not be cached.
+     * Otherwise it does nothing: the key and the cipher may be kept for the file's life.
+     */
+    public void reauthorizeEncryptor(Cipher cipher, String keyAlias) throws IOException
+    {
+        if (keyProvider.keysMayBeCached())
+            return;
+        initialize(cipher, keyProvider.keyForAppend(keyAlias), cipher.getIV(), Cipher.ENCRYPT_MODE);
+    }
+
+    /** A new cipher initialized with {@code key}, which is destroyed afterwards when it can be. */
+    private static Cipher initialize(String transformation, Key key, byte[] iv, int cipherMode) throws IOException
+    {
+        try
+        {
+            return initialize(Cipher.getInstance(transformation), key, iv, cipherMode);
+        }
+        catch (NoSuchAlgorithmException | NoSuchPaddingException e)
+        {
+            destroy(key);
+            throw new IOException("cannot load cipher", e);
+        }
+    }
+
+    private static Cipher initialize(Cipher cipher, Key key, byte[] iv, int cipherMode) throws IOException
+    {
+        try
+        {
+            cipher.init(cipherMode, key, new IvParameterSpec(iv));
+            return cipher;
+        }
+        catch (InvalidAlgorithmParameterException | InvalidKeyException e)
+        {
+            throw new IOException("cannot load cipher", e);
+        }
+        finally
+        {
+            destroy(key);
+        }
+    }
+
+    private static void destroy(Key key)
+    {
+        if (key instanceof Destroyable)
+        {
+            try
+            {
+                ((Destroyable) key).destroy();
+            }
+            catch (DestroyFailedException ignored)
+            {
+                // a key that cannot be wiped is left to the garbage collector
+            }
+        }
+    }
