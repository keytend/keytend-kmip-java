 import java.security.Key;
 
 /**
- * Customizable key retrieval mechanism. Implementations should expect that retrieved keys will be cached.
+ * Customizable key retrieval mechanism. Implementations should expect that retrieved keys will be cached, unless
+ * {@link #keysMayBeCached()} says otherwise.
  * Further, each key will be requested non-concurrently (that is, no stampeding herds for the same key), although
  * unique keys may be requested concurrently (unless you mark {@code getSecretKey} synchronized).
  *
@@ -30,4 +31,58 @@ import java.security.Key;
 public interface KeyProvider
 {
     Key getSecretKey(String alias) throws IOException;
+
+    /**
+     * The alias a new file is encrypted under, and records in its header, for the configured {@code key_alias}.
+     * A provider whose keys rotate returns an alias naming one version of the key, so that the file can still be
+     * decrypted after the configured alias moves on to a newer version. By default the configured alias itself.
+     */
+    default String currentAlias(String configuredAlias) throws IOException
+    {
+        return configuredAlias;
+    }
+
+    /**
+     * The key one new file is encrypted under and the alias its header records, from one lookup, so that the two
+     * always name the same key. The caller owns the key and initializes its cipher with it at once.
+     */
+    default KeyForFile keyForNewFile(String configuredAlias) throws IOException
+    {
+        String alias = currentAlias(configuredAlias);
+        return new KeyForFile(alias, getSecretKey(alias));
+    }
+
+    /**
+     * The key of a file still being appended to (a commit log segment, a hints file), asked for again before each
+     * chunk with the alias its header records. A provider whose keys are authorized for a limited time hands it out
+     * only while it may still encrypt, so that an authorization that ends stops the file's writes, not only the next
+     * file's. The caller owns the key and initializes its cipher with it at once.
+     */
+    default Key keyForAppend(String alias) throws IOException
+    {
+        return getSecretKey(alias);
+    }
+
+    /**
+     * Whether {@link CipherFactory} may keep this provider's keys, and ciphers initialized from them, for later files.
+     * A provider whose keys are authorized for a limited time (a KMIP lease, a cache TTL) returns false: each file
+     * then asks the provider for its key, and nothing outlives the file's cipher.
+     */
+    default boolean keysMayBeCached()
+    {
+        return true;
+    }
+
+    /** A key and the alias that names it. */
+    final class KeyForFile
+    {
+        public final String alias;
+        public final Key key;
+
+        public KeyForFile(String alias, Key key)
+        {
+            this.alias = alias;
+            this.key = key;
+        }
+    }
 }
